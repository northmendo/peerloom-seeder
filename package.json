{
  "name": "@peerloom/seeder",
  "version": "0.1.0",
  "description": "One blind seeder for every PeerLoom app: Holepunch blind-peer plus pairing, admission, storage limits per device, drops and keyrings. Extracted from PearOffice.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./seeder": "./src/seeder.js",
    "./client": "./src/client.js",
    "./protocol": "./src/protocol.js",
    "./keyring-record": "./src/keyringRecord.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify": "node --test test/*.test.js",
    "start": "node bin/peerloom-seeder.js"
  },
  "license": "MIT",
  "comment:peer-deps": "Dependencies are peers, as in @peerloom/core and @peerloom/host, so an app bundles one copy of each (and its hypercore patches reach the seeder too). blind-peer is pinned exactly: src/seeder.js wraps its internal methods.",
  "peerDependencies": {
    "b4a": "^1.8.0",
    "blind-peer": "3.15.1",
    "blind-peering": "^2.10.0",
    "compact-encoding": "^2.19.2",
    "corestore": "^7.13.0",
    "hyperbee": "^2.27.3",
    "hypercore-id-encoding": "^1.3.0",
    "protomux": "^3.10.3",
    "protomux-wakeup": "^2.9.0",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "@hyperswarm/testnet": "^3.1.4",
    "b4a": "^1.8.0",
    "blind-peer": "3.15.1",
    "blind-peering": "2.10.0",
    "compact-encoding": "^2.19.2",
    "corestore": "^7.13.0",
    "hyperbee": "^2.27.3",
    "hypercore-id-encoding": "^1.3.0",
    "hyperswarm": "^4.17.2",
    "protomux": "^3.10.3",
    "protomux-wakeup": "2.9.0",
    "sodium-universal": "^5.0.1"
  },
  "bin": {
    "peerloom-seeder": "bin/peerloom-seeder.js"
  }
}
