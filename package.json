{
  "name": "@peerloom/seeder",
  "version": "0.1.0",
  "description": "One blind seeder for every PeerLoom app: Holepunch blind-peer plus pairing, admission, storage limits per device, drops and keyrings. Extracted from PearOffice.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./seeder": "./src/seeder.js",
    "./client": "./src/client.js",
    "./protocol": "./src/protocol.js",
    "./keyring-record": "./src/keyringRecord.js"
  },
  "scripts": {
    "test": "node scripts/build-bare.js && node --test test/*.test.js",
    "verify": "npm test",
    "start": "node bin/peerloom-seeder.js",
    "build": "node scripts/build-bare.js",
    "dashboard": "node scripts/build-bare.js && node host/server.js",
    "dist:linux": "node scripts/dist-linux.js",
    "image": "scripts/build-umbrel-image.sh",
    "dist:installers": "node scripts/dist-installers.js"
  },
  "license": "MIT",
  "comment:peer-deps": "Dependencies are peers, as in @peerloom/core and @peerloom/host, so an app bundles one copy of each (and its hypercore patches reach the seeder too). blind-peer is pinned exactly: src/seeder.js wraps its internal methods.",
  "peerDependencies": {
    "b4a": "^1.8.0",
    "blind-peer": "3.15.1",
    "blind-peering": "^2.10.0",
    "compact-encoding": "^2.19.2",
    "corestore": "^7.13.0",
    "hyperbee": "^2.27.3",
    "hypercore-id-encoding": "^1.3.0",
    "protomux": "^3.10.3",
    "protomux-wakeup": "^2.9.0",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "@hyperswarm/testnet": "^3.1.4",
    "b4a": "^1.8.0",
    "bare-fs": "4.7.3",
    "bare-pack": "2.2.2",
    "bare-process": "^4.5.1",
    "bare-runtime": "1.34.1",
    "bare-signals": "4.2.0",
    "blind-peer": "3.15.1",
    "blind-peering": "2.10.0",
    "compact-encoding": "^2.19.2",
    "corestore": "^7.13.0",
    "esbuild": "^0.28.2",
    "flat-tree": "^1.12.1",
    "fs-native-extensions": "1.5.0",
    "hyperbee": "^2.27.3",
    "hypercore": "11.37.2",
    "hypercore-id-encoding": "^1.3.0",
    "hyperswarm": "^4.17.2",
    "protomux": "^3.10.3",
    "protomux-wakeup": "2.9.0",
    "qrcode-generator": "^2.0.4",
    "rocksdb-native": "3.17.2",
    "sodium-universal": "^5.0.1",
    "z32": "^1.1.0"
  },
  "bin": {
    "peerloom-seeder": "bin/peerloom-seeder.js"
  },
  "overrides": {
    "bare-buffer": "3.6.1",
    "bare-dns": "2.1.4",
    "bare-hrtime": "2.1.1",
    "bare-inspect": "3.1.4",
    "bare-module-lexer": "1.6.0",
    "bare-pipe": "4.2.2",
    "bare-signals": "4.2.0",
    "bare-stdio": "1.0.2",
    "bare-structured-clone": "1.6.0",
    "bare-subprocess": "6.1.0",
    "bare-tcp": "2.5.1",
    "bare-tty": "5.1.1",
    "bare-type": "1.1.0",
    "bare-url": "2.4.5",
    "fs-native-extensions": "1.5.0",
    "quickbit-native": "2.4.8",
    "udx-native": "1.20.7",
    "rocksdb-native": "3.17.2",
    "bare-fs": "4.7.3",
    "bare-assert": "1.2.0"
  }
}
