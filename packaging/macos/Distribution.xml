<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>PeerLoom Seeder</title>
  <organization>com.peerloomllc</organization>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="__ARCH__"/>
  <volume-check>
    <allowed-os-versions>
      <os-version min="12.0"/>
    </allowed-os-versions>
  </volume-check>
  <welcome file="welcome.html" mime-type="text/html"/>
  <license file="LICENSE.txt"/>
  <pkg-ref id="com.peerloomllc.seeder"/>
  <choices-outline>
    <line choice="default">
      <line choice="com.peerloomllc.seeder"/>
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="com.peerloomllc.seeder" visible="false">
    <pkg-ref id="com.peerloomllc.seeder"/>
  </choice>
  <pkg-ref id="com.peerloomllc.seeder" version="__VERSION__" onConclusion="none">PeerLoomSeeder-component.pkg</pkg-ref>
</installer-gui-script>
