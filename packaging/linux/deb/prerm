#!/bin/bash
# Debian prerm: stops the user service before its files go. On remove it is
# also disabled; on upgrade only stopped (postinst starts the new one).
# Lingering is left as it is: other services of that user may need it.
set -e
INSTALL_ROOT=/opt/peerloom-seeder
TARGET_USER="${SUDO_USER:-}"
if { [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = root ]; } && [ -n "${PKEXEC_UID:-}" ]; then TARGET_USER=$(id -un "$PKEXEC_UID" 2>/dev/null || true); fi
if { [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = root ]; } && [ -r "$INSTALL_ROOT/.install-user" ]; then TARGET_USER=$(cat "$INSTALL_ROOT/.install-user"); fi
if [ -n "$TARGET_USER" ] && [ "$TARGET_USER" != root ]; then
  TARGET_UID=$(id -u "$TARGET_USER" 2>/dev/null || true)
  if [ -n "$TARGET_UID" ]; then
    export XDG_RUNTIME_DIR="/run/user/$TARGET_UID"
    case "$1" in
      remove) runuser -u "$TARGET_USER" -- systemctl --user disable --now peerloom-seeder.service 2>/dev/null || true ;;
      upgrade) runuser -u "$TARGET_USER" -- systemctl --user stop peerloom-seeder.service 2>/dev/null || true ;;
    esac
  fi
fi
exit 0
