# /etc/peerloom-seeder.env — read by peerloom-seeder.service
# (packaging/debian/peerloom-seeder.service; runbook: docs/DEBIAN-LXC.md).
# Everything here is an environment variable of the dashboard host
# (host/server.js); it beats a SEEDER_CONFIG file, which beats the defaults.
# Uncommenting a line replaces the built-in default, not the whole file.

# Where the seeder keeps its state: the blind-peer store, the device/space
# records, and the generated dashboard password. Back this folder up.
SEEDER_DATA=/var/lib/peerloom-seeder

# What the dashboard listens on. 0.0.0.0 (every interface) is right for an
# LXC you reach from other machines; 127.0.0.1 keeps it on this box only.
# SECURITY: a non-loopback bind requires a password. If SEEDER_PASSWORD is
# not set, one is generated on first start and saved (mode 0600) at
# $SEEDER_DATA/dashboard-password; the service also prints it once.
SEEDER_HOST=0.0.0.0
SEEDER_PORT=8761

# Set your own password instead of the generated one (then delete any
# dashboard-password file the service already wrote, or it is ignored —
# this variable wins either way).
#SEEDER_PASSWORD=

# A JSON file with the same settings (data, host, port, password,
# bootstrap), for when you would rather keep them all in one file. Env
# vars above win over the file.
#SEEDER_CONFIG=/etc/peerloom-seeder.json

# The P2P swarm (DHT/hyperswarm) is separate: it always listens on every
# interface on a random UDP port — that is how peers reach the seeder — and
# it speaks only the blind-peer protocol, which admits nothing a paired
# device has not registered.

# Turn off the daily release check (the dashboard's own Update page).
#SEEDER_NO_UPDATE_CHECK=1
